---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { url } from '../../../config';
import { lurl } from '../../../i18n';

const articles = (await getCollection('historyAm')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="ታሪክና ባህል" description="የኢትዮጵያ ይሁዲዎች – የቤተ እስራኤል ታሪክ፣ ወግና ባህል።">
  <PageHero
    title="ታሪክና ባህል"
    lead="ለዘመናት የዘለቀ እምነት፣ ወግና የኢየሩሳሌም ናፍቆት፦ የቤተ እስራኤል ታሪክ።"
    icon="orit.svg"
  />
  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        {
          articles.map((a) => (
            <a class="card" href={lurl('am', `/history/${a.id}`)}>
              <img class="badge" src={url(`/icons/${a.data.icon}`)} alt="" width="64" height="64" loading="lazy" />
              <h2 class="h3">{a.data.title}</h2>
              <p>{a.data.description}</p>
              <span class="card__more">ያንብቡ →</span>
            </a>
          ))
        }
      </div>
      <div class="notice" style="margin-top:32px">
        <p>
          <strong>በቅርቡ፦</strong> በኢትዮጵያ የመንደር ሕይወት፣ በዓላት፣ ሙዚቃና ምግብ፣ ባህላዊ አለባበስና የእጅ ሥራዎች፣
          እንዲሁም የማኅበረሰቡ አባላት የግል ታሪኮች።
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .h3 {
    font-size: 1.3rem;
  }
  .icon {
    display: block;
    font-size: 2rem;
    margin-bottom: 8px;
  }
</style>
