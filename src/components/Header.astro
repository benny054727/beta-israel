---
import { nav, site, url } from '../config';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (href: string) => current === href || current.startsWith(href + '/');
---

<header class="header">
  <div class="weave" aria-hidden="true"></div>
  <div class="container header__bar">
    <a class="brand" href={url('/')}>
      <img src={url('/favicon.svg')} alt="" width="40" height="40" />
      <span>
        <strong>ביתא ישראל</strong>
        <small>נווה יעקב · ירושלים</small>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="menu-toggle__icon" aria-hidden="true"></span>
      <span class="sr-only">תפריט</span>
    </button>

    <nav id="site-nav" class="nav" aria-label="ניווט ראשי">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary nav__donate" href={url('/donate')}>תרומה</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
      nav.classList.remove('is-open');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.focus();
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 246 238 / 0.96);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--border);
  }
  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--earth);
    line-height: 1.2;
  }
  .brand strong {
    display: block;
    font-size: 1.2rem;
    font-weight: 800;
  }
  .brand small {
    display: block;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
  }
  .nav a:not(.btn) {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
  }
  .nav a:not(.btn):hover {
    background: var(--sand);
    color: var(--earth);
  }
  .nav a[aria-current='page'] {
    color: var(--terracotta-dark);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 var(--terracotta);
  }

  .menu-toggle {
    display: none;
    width: 48px;
    height: 48px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
    position: relative;
  }
  .menu-toggle__icon,
  .menu-toggle__icon::before,
  .menu-toggle__icon::after {
    position: absolute;
    left: 50%;
    width: 22px;
    height: 2px;
    background: var(--earth);
    border-radius: 2px;
    transform: translateX(-50%);
    content: '';
    transition: transform 0.2s;
  }
  .menu-toggle__icon {
    top: 50%;
  }
  .menu-toggle__icon::before {
    top: -7px;
  }
  .menu-toggle__icon::after {
    top: 7px;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon {
    background: transparent;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon::before {
    transform: translateX(-50%) translateY(7px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon::after {
    transform: translateX(-50%) translateY(-7px) rotate(-45deg);
  }

  @media (min-width: 1000px) {
    .nav {
      display: flex;
      align-items: center;
      gap: 12px;
    }
  }

  @media (max-width: 999px) {
    .menu-toggle {
      display: block;
    }
    .nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background: var(--cream);
      border-bottom: 1px solid var(--border);
      padding: 8px 16px 20px;
      box-shadow: var(--shadow);
    }
    .nav.is-open {
      display: block;
    }
    .nav ul {
      flex-direction: column;
    }
    .nav a:not(.btn) {
      padding: 12px;
      font-size: 1.1rem;
    }
    .nav a[aria-current='page'] {
      box-shadow: inset -4px 0 0 var(--terracotta);
    }
    .nav__donate {
      margin-top: 12px;
      width: 100%;
    }
  }
</style>
