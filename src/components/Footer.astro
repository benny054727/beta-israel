---
import { site } from '../config';
import { ui, lurl, langFromPath, languages, pagePath } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const t = ui[lang];
const year = new Date().getFullYear();
const a = site.association;
---

<footer class="footer">
  <div class="weave" aria-hidden="true"></div>
  <div class="container footer__grid">
    <div>
      <p class="footer__title">{t.siteName}</p>
      <p>{t.tagline}</p>
      <p>📍 {t.address}</p>
      {site.phone && <p>📞 <a href={`tel:${site.phone}`} dir="ltr">{site.phone}</a></p>}
      {site.email && <p>✉️ <a href={`mailto:${site.email}`}>{site.email}</a></p>}
    </div>

    <nav aria-label={t.footerNav}>
      <p class="footer__title">{t.onSite}</p>
      <ul>
        {t.nav.map((i) => <li><a href={lurl(lang, i.href)}>{i.label}</a></li>)}
        <li><a href={lurl(lang, '/donate')}>{t.donate}</a></li>
      </ul>
    </nav>

    <div>
      <p class="footer__title">{t.association}</p>
      <p>
        {t.donationsBefore}{t.association}{a.registrationNumber && <> ({t.regNo} {a.registrationNumber})</>}{t.donationsAfter}
      </p>
      <a class="btn btn--light" href={lurl(lang, '/donate')}>{t.toDonate}</a>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {t.siteName}</p>
    <ul>
      <li><a href={lurl(lang, '/accessibility')}>{t.accessibility}</a></li>
      <li><a href={lurl(lang, '/privacy')}>{t.privacy}</a></li>
      {
        languages
          .filter((l) => l.code !== lang)
          .map((l) => (
            <li>
              <a href={lurl(l.code, pagePath(Astro.url.pathname))} lang={l.code} hreflang={l.code}>{l.label}</a>
            </li>
          ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--earth);
    color: #f1e4d3;
    margin-top: 0;
  }
  .footer a:not(.btn) {
    color: #fff;
  }
  .footer__grid {
    display: grid;
    gap: 32px;
    padding-block: 48px 32px;
  }
  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
  }
  .footer__title {
    color: #fff;
    font-weight: 800;
    font-size: 1.1rem;
    margin-bottom: 0.6em;
  }
  .footer p {
    margin-bottom: 0.5em;
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer li {
    margin-bottom: 0.4em;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid rgb(255 255 255 / 0.2);
    padding-block: 20px;
    font-size: 0.95rem;
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__bottom ul {
    display: flex;
    gap: 20px;
  }
  .footer__bottom li {
    margin: 0;
  }
</style>
