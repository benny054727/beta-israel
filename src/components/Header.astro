---
import { nav, url } from '../config';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (href: string) => current === href || current.startsWith(href + '/');
---

<header class="header">
  <div class="weave" aria-hidden="true"></div>
  <div class="container header__bar">
    <a class="brand" href={url('/')}>
      <img src={url('/favicon.svg')} alt="" width="40" height="40" />
      <span>
        <strong>ביתא ישראל</strong>
        <small>נווה יעקב · ירושלים</small>
      </span>
    </a>

    <!-- מחשב: תפריט מלא בשורה העליונה -->
    <nav class="nav" aria-label="ניווט ראשי">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary" href={url('/donate')}>תרומה</a>
    </nav>

    <!-- טלפון: קישורים משניים קטנים למעלה -->
    <ul class="header__mini" aria-label="קישורים נוספים">
      <li><a href={url('/about')} aria-current={isActive('/about') ? 'page' : undefined}>אודות</a></li>
      <li><a href={url('/contact')} aria-current={isActive('/contact') ? 'page' : undefined}>צור קשר</a></li>
    </ul>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 246 238 / 0.96);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--border);
  }
  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--earth);
    line-height: 1.2;
  }
  .brand strong {
    display: block;
    font-size: 1.2rem;
    font-weight: 800;
  }
  .brand small {
    display: block;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
  }
  .nav a:not(.btn) {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
  }
  .nav a:not(.btn):hover {
    background: var(--sand);
    color: var(--earth);
  }
  .nav a[aria-current='page'] {
    color: var(--terracotta-dark);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 var(--terracotta);
  }

  .header__mini {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 4px;
  }
  .header__mini a {
    display: block;
    padding: 10px 10px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--earth);
    text-decoration: none;
  }
  .header__mini a[aria-current='page'] {
    color: var(--terracotta-dark);
    font-weight: 700;
    background: var(--sand);
  }

  @media (max-width: 999px) {
    .nav {
      display: none;
    }
    .header__mini {
      display: flex;
    }
  }
</style>
