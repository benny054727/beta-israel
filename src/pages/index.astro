---
import Base from '../layouts/Base.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import { getCollection } from 'astro:content';
import { site, url } from '../config';

const articles = (await getCollection('history')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <span class="eyebrow">ברוכים הבאים · <span lang="am" dir="ltr">እንኳን ደህና መጣችሁ</span></span>
        <h1>ביתא ישראל<br />נווה יעקב, ירושלים</h1>
        <p class="hero__lead">
          בית הכנסת של קהילת יהודי אתיופיה בירושלים. כאן שומרים על המסורת של ביתא ישראל, חוגגים את
          החגים יחד, ופותחים את הדלת לכל מי שרוצה להכיר את הסיפור של הקהילה.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={url('/tours')}>להזמנת סיור חינם</a>
          <a class="btn btn--outline" href={url('/donate')}>לתרומה</a>
        </div>
      </div>
      <PhotoPlaceholder label="תמונה של בית הכנסת – תתווסף בקרוב" />
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <div class="grid grid--3">
        <a class="card quick" href={url('/tours')}>
          <span class="quick__icon" aria-hidden="true">🚶‍♀️</span>
          <h2 class="h3">סיור בבית הכנסת</h2>
          <p>סיור חינם בעברית, באנגלית או באמהרית, על ההיסטוריה, המסורת ובית הכנסת.</p>
          <span class="card__more">להזמנה ←</span>
        </a>
        <a class="card quick" href={url('/events')}>
          <span class="quick__icon" aria-hidden="true">📅</span>
          <h2 class="h3">אירועים</h2>
          <p>חגים, הרצאות, ערבי תרבות ופעילויות לקהילה. כולם מוזמנים.</p>
          <span class="card__more">ללוח האירועים ←</span>
        </a>
        <a class="card quick" href={url('/donate')}>
          <span class="quick__icon" aria-hidden="true">🤲</span>
          <h2 class="h3">תרומה</h2>
          <p>התרומה שלכם מממנת עוד אירועים, פעילות לקהילה ופרויקטים לאמנים צעירים.</p>
          <span class="card__more">לתרומה ←</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">היסטוריה ותרבות</span>
      <h2>סיפור של אמונה וגעגועים לירושלים</h2>
      <p class="section__intro">
        במשך מאות שנים שמרו יהודי אתיופיה על התורה, על השבת ועל החלום לשוב לירושלים. היום החלום
        הזה חי בבית הכנסת בנווה יעקב.
      </p>
      <div class="grid grid--3">
        {
          articles.map((a) => (
            <a class="card" href={url(`/history/${a.id}`)}>
              <span class="quick__icon" aria-hidden="true">{a.data.icon}</span>
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
              <span class="card__more">לקריאה ←</span>
            </a>
          ))
        }
      </div>
      <p style="margin-top:24px">
        <a class="btn btn--outline" href={url('/history')}>לכל המאמרים</a>
      </p>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container split">
      <div>
        <span class="eyebrow">איך התרומה עובדת</span>
        <h2>העירייה מממנת את הבסיס. אתם מממנים את מה שמעבר.</h2>
        <p>
          העלויות השוטפות של בית הכנסת ממומנות ע"י העירייה. אבל כדי לקיים עוד אירועים, להרחיב
          את הפעילות לקהילה ולקדם אמנים צעירים, אנחנו צריכים את העזרה שלכם.
        </p>
        <p>התרומות מתקבלות ע"י <strong>{site.association.name}</strong>.</p>
        <a class="btn btn--primary" href={url('/donate')}>אני רוצה לתרום</a>
      </div>
      <ul class="pillars">
        <li><strong>🎉 אירועים</strong><span>חגים, ערבי תרבות והרצאות</span></li>
        <li><strong>👨‍👩‍👧 פעילות לקהילה</strong><span>לכל הגילאים, מהילדים ועד הוותיקים</span></li>
        <li><strong>🎨 פרויקט האמנים</strong><span>תערוכות, סדנאות וליווי לציירים צעירים</span></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(40px, 7vw, 80px);
  }
  .hero__grid {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .hero__grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 48px;
    }
  }
  .hero h1 {
    margin-bottom: 0.4em;
  }
  .hero__lead {
    font-size: 1.2rem;
    color: var(--ink-soft);
    max-width: 560px;
    margin-bottom: 1.5em;
  }
  .h3 {
    font-size: 1.25rem;
  }
  .quick__icon {
    display: block;
    font-size: 2rem;
    margin-bottom: 8px;
  }
  .split {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .split {
      grid-template-columns: 1.2fr 1fr;
      gap: 56px;
    }
  }
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .pillars li {
    background: #fff;
    border: 1px solid var(--border);
    border-inline-start: 6px solid var(--terracotta);
    border-radius: 12px;
    padding: 16px 20px;
  }
  .pillars strong {
    display: block;
    color: var(--earth);
    font-size: 1.1rem;
  }
  .pillars span {
    color: var(--ink-soft);
  }
</style>
