---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import { url } from '../config';
import { ui, lurl, pagePath, langFromPath, languages } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const lang = langFromPath(Astro.url.pathname);
const t = ui[lang];
const { title, description = t.description } = Astro.props;
const fullTitle = title ? `${title} | ${t.siteName}` : t.siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = pagePath(Astro.url.pathname);
const alternates = languages.map((l) => ({ code: l.code, href: new URL(lurl(l.code, path), Astro.site) }));
---

<!doctype html>
<html lang={lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#5b3a29" />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-title" content="ביתא ישראל" />
    <meta name="mobile-web-app-capable" content="yes" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@700;900&family=Heebo:wght@400;500;700;800&family=Noto+Sans+Ethiopic:wght@400;700&display=optional"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header />
    {
      t.reviewNote && (
        <p class="review-note" role="note">
          {t.reviewNote} <a href={lurl(lang, '/contact')}>{ui[lang].contact}</a>
        </p>
      )
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BottomNav />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: 16px;
    top: -60px;
    z-index: 100;
    background: var(--earth);
    color: #fff;
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: 700;
  }
  .skip-link:focus {
    top: 12px;
    color: #fff;
  }
  main:focus {
    outline: none;
  }
  .review-note {
    margin: 0;
    padding: 8px 16px;
    background: #fff3d6;
    border-bottom: 1px solid #f0d58f;
    color: var(--ink);
    font-size: 0.92rem;
    text-align: center;
  }
  /* מקום לסרגל הניווט התחתון בטלפון, כדי שלא יסתיר את סוף העמוד */
  @media (max-width: 1199px) {
    body {
      padding-bottom: calc(64px + env(safe-area-inset-bottom));
    }
  }
</style>
