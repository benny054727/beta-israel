---
/** סרגל ניווט קבוע בתחתית המסך – מוצג בטלפון ובטאבלט בלבד */
import { ui, lurl, pagePath, langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const t = ui[lang];
const current = pagePath(Astro.url.pathname);
const isActive = (href: string) =>
  href === '/' ? current === '/' : current === href || current.startsWith(href + '/');

// אייקונים בקו פשוט (SVG)
const icons: Record<string, string> = {
  home: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9.5h13V10"/><path d="M10 19.5v-5h4v5"/>',
  synagogue: '<path d="M12 3 7.4 11h9.2Z"/><path d="M12 13.7 16.6 5.7H7.4Z"/><path d="M4 21h16"/><path d="M5 21v-6h14v6"/>',
  history: '<path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3Z"/><path d="M5 17a3 3 0 0 1 3-3h11"/><path d="M9 8h6"/>',
  events: '<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17"/><path d="M8 3v4M16 3v4"/>',
  tours: '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4"/>',
  donate: '<path d="M12 20s-7.5-4.6-7.5-10.2A4.2 4.2 0 0 1 12 7.4a4.2 4.2 0 0 1 7.5 2.4C19.5 15.4 12 20 12 20Z"/>',
};

const items = [
  { href: '/', label: t.bottom.home, icon: 'home' },
  { href: '/synagogue', label: t.bottom.synagogue, icon: 'synagogue' },
  { href: '/history', label: t.bottom.history, icon: 'history' },
  { href: '/events', label: t.bottom.events, icon: 'events' },
  { href: '/tours', label: t.bottom.tours, icon: 'tours' },
  { href: '/donate', label: t.bottom.donate, icon: 'donate', accent: true },
];
---

<nav class="bottom-nav" aria-label={t.mainNav}>
  <ul>
    {
      items.map((i) => (
        <li>
          <a
            href={lurl(lang, i.href)}
            class:list={[{ accent: i.accent }]}
            aria-current={isActive(i.href) ? 'page' : undefined}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i.icon]} />
            <span>{i.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .bottom-nav {
    display: none;
  }

  @media (max-width: 1199px) {
    .bottom-nav {
      display: block;
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 60;
      background: #fff;
      border-top: 1px solid var(--border);
      box-shadow: 0 -4px 18px rgb(91 58 41 / 0.1);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .bottom-nav ul {
      list-style: none;
      margin: 0 auto;
      padding: 0 4px;
      max-width: 640px;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
    }
    .bottom-nav a {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      min-height: 62px;
      padding: 6px 2px;
      color: var(--ink-soft);
      text-decoration: none;
      font-size: 0.72rem;
      font-weight: 500;
      line-height: 1.15;
      text-align: center;
      position: relative;
    }
    .bottom-nav svg {
      width: 25px;
      height: 25px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .bottom-nav a[aria-current='page'] {
      color: var(--terracotta-dark);
      font-weight: 700;
    }
    .bottom-nav a[aria-current='page']::before {
      content: '';
      position: absolute;
      top: 0;
      inset-inline: 22%;
      height: 3px;
      border-radius: 0 0 3px 3px;
      background: var(--terracotta);
    }
    .bottom-nav a.accent svg {
      color: #fff;
      background: var(--terracotta);
      border-radius: 999px;
      padding: 5px;
      width: 34px;
      height: 34px;
      margin-top: -4px;
    }
    .bottom-nav a.accent {
      color: var(--terracotta-dark);
      font-weight: 700;
    }
    .bottom-nav a.accent[aria-current='page']::before {
      display: none;
    }
  }
</style>
