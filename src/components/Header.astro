---
import { url } from '../config';
import { ui, lurl, pagePath, langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const other = lang === 'he' ? 'en' : 'he';
const t = ui[lang];
const current = pagePath(Astro.url.pathname);
const isActive = (href: string) => current === href || current.startsWith(href + '/');
const switchHref = lurl(other, current);
---

<header class="header">
  <div class="weave weave--thin" aria-hidden="true"></div>
  <div class="container header__bar">
    <a class="brand" href={lurl(lang, '/')}>
      <img src={url('/favicon.svg')} alt="" width="40" height="40" />
      <span>
        <strong>{t.brand}</strong>
        <small>{t.brandSub}</small>
      </span>
    </a>

    <!-- מחשב: תפריט מלא בשורה העליונה -->
    <nav class="nav" aria-label={t.mainNav}>
      <ul>
        {
          t.nav.map((item) => (
            <li>
              <a href={lurl(lang, item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="lang-switch" href={switchHref} hreflang={other} lang={other} title={t.switchTitle}>{t.switchLabel}</a>
      <a class="btn btn--primary" href={lurl(lang, '/donate')}>{t.donate}</a>
    </nav>

    <!-- טלפון: קישורים משניים קטנים למעלה -->
    <ul class="header__mini" aria-label={t.moreLinks}>
      <li><a href={lurl(lang, '/about')} aria-current={isActive('/about') ? 'page' : undefined}>{t.about}</a></li>
      <li><a href={lurl(lang, '/contact')} aria-current={isActive('/contact') ? 'page' : undefined}>{t.contact}</a></li>
      <li><a class="lang-switch" href={switchHref} hreflang={other} lang={other} title={t.switchTitle}>{lang === 'he' ? 'EN' : 'עב'}</a></li>
    </ul>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 246 238 / 0.96);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--border);
  }
  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--earth);
    line-height: 1.2;
  }
  .brand strong {
    display: block;
    font-size: 1.2rem;
    font-weight: 800;
  }
  /* במחשב השם לא נשבר לשתי שורות; בטלפון מותר, כדי שלא יגלוש הצידה */
  @media (min-width: 1200px) {
    .brand strong,
    .brand small {
      white-space: nowrap;
    }
  }
  .brand small {
    display: block;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
  }
  .nav a:not(.btn) {
    display: block;
    white-space: nowrap;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
  }
  .nav a:not(.btn):hover {
    background: var(--sand);
    color: var(--earth);
  }
  .nav a[aria-current='page'] {
    color: var(--terracotta-dark);
    box-shadow: inset 0 -3px 0 var(--terracotta);
  }

  .header__mini {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 4px;
  }
  .header__mini a {
    display: block;
    padding: 10px 10px;
    border-radius: 8px;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--earth);
    text-decoration: none;
  }
  .header__mini a[aria-current='page'] {
    color: var(--terracotta-dark);
    background: var(--sand);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    min-width: 44px;
    padding: 0 12px;
    border: 1.5px solid var(--earth);
    border-radius: 999px;
    color: var(--earth) !important;
    font-weight: 700 !important;
    font-size: 0.9rem !important;
    text-decoration: none;
  }
  .lang-switch:hover {
    background: var(--earth) !important;
    color: #fff !important;
  }
  .header__mini {
    align-items: center;
  }

  @media (max-width: 420px) {
    .header__bar {
      gap: 8px;
    }
    .header__mini a {
      padding: 8px 6px;
      font-size: 0.9rem;
    }
    .brand img {
      width: 34px;
      height: 34px;
    }
  }
  @media (max-width: 359px) {
    .brand small {
      display: none;
    }
  }

  @media (max-width: 1199px) {
    .nav {
      display: none;
    }
    .header__mini {
      display: flex;
    }
  }
</style>
