---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../config';

export async function getStaticPaths() {
  const articles = (await getCollection('history')).sort((a, b) => a.data.order - b.data.order);
  return articles.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: articles[i + 1] ?? null },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <PageHero title={entry.data.title} lead={entry.data.description} />
  <section class="section">
    <div class="container">
      <article class="prose">
        {
          !entry.data.reviewed && (
            <div class="notice" style="margin-bottom:28px">
              <p>
                טיוטה: הטקסט ממתין לבדיקה ולאישור של קייסים וזקני הקהילה. יש לכם תיקון או
                הוספה? <a href={url('/contact')}>נשמח לשמוע</a>.
              </p>
            </div>
          )
        }

        <Content />

        {
          entry.data.sources.length > 0 && (
            <>
              <h2>מקורות</h2>
              <ul>
                {entry.data.sources.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </>
          )
        }

        <hr />
        <div class="btn-row">
          <a class="btn btn--outline" href={url('/history')}>→ לכל המאמרים</a>
          {next && <a class="btn btn--outline" href={url(`/history/${next.id}`)}>הבא: {next.data.title} ←</a>}
          <a class="btn btn--primary" href={url('/tours')}>לסיור בבית הכנסת</a>
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
  hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 40px 0 24px;
  }
</style>
