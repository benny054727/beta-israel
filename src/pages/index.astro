---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site, url } from '../config';

const articles = (await getCollection('history')).sort((a, b) => a.data.order - b.data.order).slice(0, 4);

const quick = [
  { href: '/tours', icon: 'tours.png', title: 'סיור בבית הכנסת', text: 'סיור חינם בעברית, באנגלית או באמהרית', cta: 'להזמנה' },
  { href: '/events', icon: 'events.png', title: 'אירועים', text: 'חגים, ערבי תרבות ופעילויות. כולם מוזמנים', cta: 'ללוח האירועים' },
  { href: '/history', icon: 'origins.svg', title: 'היסטוריה ותרבות', text: 'הסיפור של ביתא ישראל, מאתיופיה לירושלים', cta: 'לקריאה' },
  { href: '/donate', icon: 'donate.png', title: 'תרומה', text: 'עוד אירועים, פעילות לקהילה ופרויקט אמנים', cta: 'לתרומה' },
];

const pillars = [
  { icon: 'events.png', title: 'אירועים', text: 'חגים, ערבי תרבות והרצאות' },
  { icon: 'community.png', title: 'פעילות לקהילה', text: 'לכל הגילאים, מהילדים ועד הוותיקים' },
  { icon: 'artists.svg', title: 'פרויקט האמנים', text: 'תערוכות, סדנאות וליווי לציירים צעירים' },
];
---

<Base>
  <section class:list={['hero', { 'hero--art': site.heroImage }]}>
    <div class="container hero__grid">
      <div class="hero__text">
        <span class="hero__eyebrow">ברוכים הבאים · <span lang="am" dir="ltr">እንኳን ደህና መጣችሁ</span></span>
        <h1>ביתא ישראל<br /><span class="hero__accent">נווה יעקב, ירושלים</span></h1>
        <p class="hero__lead">
          בית הכנסת של קהילת יהודי אתיופיה בירושלים. כאן שומרים על המסורת של ביתא ישראל, חוגגים את
          החגים יחד, ופותחים את הדלת לכל מי שרוצה להכיר את הסיפור של הקהילה.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href={url('/tours')}>להזמנת סיור חינם</a>
          <a class="btn btn--outline btn--lg" href={url('/donate')}>לתרומה</a>
        </div>
      </div>

      {
        !site.heroImage && (
          <div class="hero__medallion" aria-hidden="true">
            <div class="medallion">
              <img src={url('/favicon.svg')} alt="" width="120" height="120" />
            </div>
            <img class="orbit orbit--1" src={url('/icons/tours.png')} alt="" width="76" height="76" />
            <img class="orbit orbit--2" src={url('/icons/events.png')} alt="" width="76" height="76" />
            <img class="orbit orbit--3" src={url('/icons/community.png')} alt="" width="76" height="76" />
            <img class="orbit orbit--4" src={url('/icons/donate.png')} alt="" width="76" height="76" />
          </div>
        )
      }
    </div>

    {
      site.heroImage && (
        <img
          class="hero__art"
          src={url(`/images/${site.heroImage}`)}
          alt="איור: חומות ירושלים, סל מסוב וג'בנה, עם פס אריגה אתיופי"
          width="2720"
          height="1536"
        />
      )
    }
  </section>
  <div class="weave" aria-hidden="true"></div>

  <section class="section quick-wrap">
    <div class="container">
      <ul class="quick">
        {
          quick.map((q) => (
            <li>
              <a class="quick__card" href={url(q.href)}>
                <img class="badge" src={url(`/icons/${q.icon}`)} alt="" width="64" height="64" loading="lazy" />
                <h2 class="quick__title">{q.title}</h2>
                <p>{q.text}</p>
                <span class="card__more">{q.cta} ←</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--sand">
    <div class="container">
      <span class="eyebrow">היסטוריה ותרבות</span>
      <h2>סיפור של אמונה וגעגועים לירושלים</h2>
      <p class="section__intro">
        במשך מאות שנים שמרו יהודי אתיופיה על התורה, על השבת ועל החלום לשוב לירושלים. היום החלום
        הזה חי בבית הכנסת בנווה יעקב.
      </p>
      <div class="grid grid--4">
        {
          articles.map((a) => (
            <a class="card story" href={url(`/history/${a.id}`)}>
              <img class="badge" src={url(`/icons/${a.data.icon}`)} alt="" width="64" height="64" loading="lazy" />
              <h3>{a.data.title}</h3>
              <p>{a.data.description}</p>
              <span class="card__more">לקריאה ←</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--green">
    <div class="container split">
      <div>
        <span class="eyebrow">איך התרומה עובדת</span>
        <h2>העירייה מממנת את הבסיס.<br />אתם מממנים את מה שמעבר.</h2>
        <p>
          העלויות השוטפות של בית הכנסת ממומנות ע"י העירייה. אבל כדי לקיים עוד אירועים, להרחיב
          את הפעילות לקהילה ולקדם אמנים צעירים, אנחנו צריכים את העזרה שלכם.
        </p>
        <p>התרומות מתקבלות ע"י <strong>{site.association.name}</strong>.</p>
        <a class="btn btn--gold btn--lg" href={url('/donate')}>אני רוצה לתרום</a>
      </div>
      <ul class="pillars">
        {
          pillars.map((p) => (
            <li>
              <img class="badge badge--sm" src={url(`/icons/${p.icon}`)} alt="" width="48" height="48" loading="lazy" />
              <div>
                <strong>{p.title}</strong>
                <span>{p.text}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ===== פתיח ===== */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 7vw, 88px);
    background:
      radial-gradient(ellipse at 90% 10%, rgb(201 150 43 / 0.18), transparent 50%),
      radial-gradient(ellipse at 5% 90%, rgb(164 69 44 / 0.12), transparent 55%),
      var(--cream);
  }
  .hero--art {
    padding-bottom: 0;
  }
  .hero__grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 56px;
    }
  }
  .hero__eyebrow {
    display: inline-block;
    padding: 6px 14px;
    margin-bottom: 18px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--border);
    color: var(--terracotta-dark);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .hero h1 {
    margin-bottom: 0.35em;
  }
  .hero__accent {
    color: var(--terracotta);
  }
  .hero__lead {
    font-size: clamp(1.1rem, 2.2vw, 1.25rem);
    color: var(--ink-soft);
    max-width: 560px;
    margin-bottom: 1.6em;
  }
  .hero__art {
    display: block;
    width: 100%;
    height: auto;
    max-height: 560px;
    object-fit: cover;
    object-position: center bottom;
    margin-top: 32px;
  }

  /* מדליון עם אייקונים – מוצג כל עוד אין איור ראשי */
  .hero__medallion {
    position: relative;
    width: min(100%, 400px);
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .medallion {
    position: absolute;
    inset: 16%;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle, var(--night) 0 58%, transparent 59%),
      repeating-conic-gradient(from 0deg, var(--terracotta) 0 10deg, var(--gold) 10deg 20deg, var(--green) 20deg 30deg);
    box-shadow:
      0 0 0 10px #fff,
      0 0 0 12px var(--border),
      0 24px 60px rgb(91 58 41 / 0.25);
  }
  .medallion img {
    width: 46%;
    height: auto;
  }
  .orbit {
    position: absolute;
    width: 22%;
    height: auto;
    border-radius: 50%;
    box-shadow: 0 10px 24px rgb(91 58 41 / 0.25);
    animation: float 6s ease-in-out infinite;
  }
  .orbit--1 { top: 0; inset-inline-start: 6%; }
  .orbit--2 { top: 4%; inset-inline-end: 4%; animation-delay: -1.5s; }
  .orbit--3 { bottom: 4%; inset-inline-start: 2%; animation-delay: -3s; }
  .orbit--4 { bottom: 0; inset-inline-end: 8%; animation-delay: -4.5s; }
  @keyframes float {
    50% { transform: translateY(-8px); }
  }
  @media (max-width: 899px) {
    .hero__medallion {
      width: min(80%, 320px);
    }
  }

  /* ===== כרטיסי פעולה ===== */
  .quick-wrap {
    padding-top: clamp(32px, 6vw, 64px);
  }
  .quick {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 900px) {
    .quick {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }
  .quick__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px 18px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s;
  }
  .quick__card:hover {
    transform: translateY(-4px);
    border-color: var(--gold);
    box-shadow: 0 16px 36px rgb(91 58 41 / 0.15);
  }
  .quick__title {
    font-family: var(--font);
    font-size: 1.15rem;
    margin-bottom: 0.3em;
  }
  .quick__card p {
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.55;
    flex: 1;
  }
  @media (max-width: 480px) {
    .quick__card {
      padding: 18px 14px;
    }
    .quick__card .badge {
      width: 52px;
      height: 52px;
    }
    .quick__card p {
      font-size: 0.92rem;
    }
  }

  /* ===== מאמרים ===== */
  .story h3 {
    font-size: 1.2rem;
  }
  .story p {
    color: var(--ink-soft);
    line-height: 1.6;
  }

  /* ===== תרומה ===== */
  .split {
    display: grid;
    gap: 36px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1.2fr 1fr;
      gap: 64px;
    }
  }
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .pillars li {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 16px;
    padding: 16px 18px;
  }
  .pillars strong {
    display: block;
    color: #fff;
    font-size: 1.1rem;
  }
  .pillars span {
    color: #d6e3de;
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit {
      animation: none;
    }
  }
</style>
